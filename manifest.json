{
  "manifest_version": 3,
  "name": "Screenshot Bookmark",
  "version": "2.1.0",
  "author": "Grww Tech",
  "description": "Capture, annotate, organise, and revisit web page screenshots.",

  "permissions": [
    "activeTab",
    "tabs",
    "contextMenus",
    "storage",
    "unlimitedStorage",
    "scripting",
    "notifications",
    "alarms",
    "downloads"
  ],

  "host_permissions": [],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-128.png",
      "48": "icons/icon-128.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Screenshot Bookmark"
  },

  "commands": {
    "capture-screenshot": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "Capture a screenshot bookmark"
    }
  },

  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "icons/icon-128.png",
    "48": "icons/icon-128.png",
    "128": "icons/icon-128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["content/styles/*.css"],
      "matches": ["<all_urls>"]
    }
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/shortcuts.js"],
      "run_at": "document_start"
    }
  ]
}
